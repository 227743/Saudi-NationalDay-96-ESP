using ScreenDraw = void (*)();

void drawProfile();
void drawNational();
void drawLogo();

struct ScreenStep {
    ScreenDraw draw;
    uint32_t   duration;
};

const ScreenStep SCREENS[] = {
    { drawProfile,  FLAG_TIME  },
    { drawNational, NATIONAL_TIME },
    { drawLogo,     LOGO_TIME     },
};
constexpr size_t SCREEN_COUNT = sizeof(SCREENS) / sizeof(SCREENS[0]);


uint32_t lastScreenTick = 0;
size_t   screenIndex    = 0;

void drawCentered(const char* text, int16_t y, uint8_t size) {
    display.setTextSize(size);
    int16_t x1, y1;
    uint16_t w, h;
    display.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
    display.setCursor((SCREEN_W - w) / 2 - x1, y);
    display.print(text);
}


void drawProfile() {
    display.clearDisplay();
    display.drawBitmap(0, 0, BITMAP_FLAG, SCREEN_W, SCREEN_H, SH110X_WHITE);
    display.fillRect(0, 50, SCREEN_W, SCREEN_H - 50, SH110X_BLACK);
    drawCentered(USERNAME, 52, 1);
    display.display();
}

void drawNational() {
    display.clearDisplay();

    display.setTextSize(1);
    display.setCursor(6, 4);
    display.print(F("#KSA_96"));

    display.drawLine(4, 16, 124, 16, SH110X_WHITE);

    drawCentered("HAPPY",    24, 2);
    drawCentered("NATIONAL", 42, 2);
    drawCentered("DAY 96",   58, 1);

    display.display();
}

void drawLogo() {
    display.clearDisplay();
    display.drawBitmap(0, 0, BITMAP_LOGO, SCREEN_W, SCREEN_H, SH110X_WHITE);
    display.display();
}

// ---------- Arduino ----------
void setup() {
    Serial.begin(115200);

    Wire.begin(SDA_PIN, SCL_PIN);
    if (!display.begin(OLED_ADDR, true)) {
        Serial.println(F("SH1106 init failed"));
        while (true) delay(1000);
    }

    display.clearDisplay();
    display.setTextColor(SH110X_WHITE);
    display.display();

    SCREENS[screenIndex].draw();
    Serial.println(F("KSA96 badge ready"));
}

void loop() {
    const uint32_t now = millis();

    if (now - lastScreenTick >= SCREENS[screenIndex].duration) {
        lastScreenTick = now;
        screenIndex = (screenIndex + 1) % SCREEN_COUNT;
        SCREENS[screenIndex].draw();
    }
}